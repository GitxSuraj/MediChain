# MediChain Backend — Environment Variables
# Copy this file to .env and fill in your real values

# MongoDB connection
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
DATABASE_NAME=hospital_network

# Razorpay (test mode) — Sign up at razorpay.com, go to Test Mode > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# JWT secret for hospital staff tokens
JWT_SECRET=your-secret-key-here